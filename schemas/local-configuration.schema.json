{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:io.github.ashergarland:agent-tool-server-shopgoodwill:local-configuration:v1",
  "title": "ShopGoodwill capability local configuration",
  "description": "Bounded capability-owned provider configuration. The approval flag is an engineering safety gate and does not create legal authorization.",
  "type": "object",
  "properties": {
    "SHOPGOODWILL_PROVIDER_MODE": {
      "type": "string",
      "enum": ["disabled", "fixture", "authorized"],
      "default": "disabled"
    },
    "SHOPGOODWILL_API_BASE_URL": {
      "type": "string",
      "format": "uri",
      "maxLength": 2048
    },
    "SHOPGOODWILL_ACCESS_APPROVED": {
      "type": "boolean",
      "default": false
    },
    "SHOPGOODWILL_API_TOKEN": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "writeOnly": true
    },
    "SHOPGOODWILL_REQUEST_TIMEOUT_MS": {
      "type": "integer",
      "minimum": 100,
      "maximum": 60000,
      "default": 10000
    },
    "SHOPGOODWILL_MIN_REQUEST_INTERVAL_MS": {
      "type": "integer",
      "minimum": 0,
      "maximum": 60000,
      "default": 1000
    },
    "SHOPGOODWILL_MAX_RESPONSE_BYTES": {
      "type": "integer",
      "minimum": 1024,
      "maximum": 5000000,
      "default": 1000000
    },
    "SHOPGOODWILL_SELLER_DIRECTORY_PATH": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "default": "Search/GetActiveLocation",
      "description": "Verified buyer-compatible active-location route, or an operator-configured relative path within the approved provider origin. Schemes, authorities, credentials, queries, fragments, backslashes, and dot segments are not allowed.",
      "pattern": "^(?!/)(?!.*//)(?!.*(?:^|/)\\.\\.?(?:/|$))[A-Za-z0-9._~!$&'()*+,;=/-]+$"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "SHOPGOODWILL_PROVIDER_MODE": {
            "const": "authorized"
          }
        },
        "required": ["SHOPGOODWILL_PROVIDER_MODE"]
      },
      "then": {
        "required": ["SHOPGOODWILL_API_BASE_URL", "SHOPGOODWILL_ACCESS_APPROVED"],
        "properties": {
          "SHOPGOODWILL_ACCESS_APPROVED": {
            "const": true
          }
        }
      }
    }
  ],
  "additionalProperties": false
}
